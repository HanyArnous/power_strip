    <string name="link_saved">Server IP saved to Settings — the Plugs tab is ready.</string>
    <string name="link_got_ip">Server address saved inside the strip.</string>
    <string name="link_got_wifi">Home Wi-Fi saved inside the strip.</string>
    <string name="link_watch">Watch TONLY_TAP_* disappear within a minute — that means the strip accepted the Wi-Fi and rebooted. If it stays visible, the name/password was wrong or not 2.4 GHz.</string>
    <string name="link_verify_title">How to confirm it worked</string>
    <string name="link_verify_1">Rejoin your home Wi-Fi on this phone.</string>
    <string name="link_verify_2">Open Plugs — the strip shows online within seconds.</string>

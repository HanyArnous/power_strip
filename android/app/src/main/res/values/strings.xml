    <string name="setup_title">First-time setup</string>
    <string name="setup_step_1">Run power-strip.py on the machine that stays on, and note the IP it prints.</string>
    <string name="setup_step_2">Enter that IP, port and token here, then press Test.</string>
    <string name="setup_step_3">Point the strip at that machine once:</string>
    <string name="setup_step_4">Done — the strip connects on its own. No router DNS or port forwarding.</string>
    <string name="setup_footer">The Android app talks to the same JSON API as the web UI.</string>

    <string name="link_title">Link a new strip</string>
    <string name="link_body">The phone talks to the strip directly on its setup network — no PC needed. Join TONLY_TAP_* first, then link.</string>
    <string name="link_step_1">Hold the strip button ~10s until the LED blinks fast.</string>
    <string name="link_step_2">On this phone, join the TONLY_TAP_* Wi-Fi (password LGU_XXXXXXX).</string>
    <string name="link_step_3">Enter the server IP and home Wi-Fi below, then press Link.</string>
    <string name="link_step_4">Rejoin your home Wi-Fi — the strip comes online by itself.</string>
    <string name="field_server_ip">Server IP (written into the strip)</string>
